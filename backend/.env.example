# ===========================================
# Personalized Cloud Computing — Environment
# ===========================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.

# Database connection string
# For SQLite (development):
DATABASE_URL=sqlite:///./cloud.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://cloud_user:cloud_pass@localhost:5432/cloud_db

# Application secret key (used for JWT signing in Sprint 2)
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-production

# Debug mode (set to false in production)
DEBUG=true

# Application version
APP_VERSION=0.1.0
