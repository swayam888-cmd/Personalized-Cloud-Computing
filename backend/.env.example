# ===========================================
# Personalized Cloud Computing — Environment
# ===========================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.

# Database connection string
# For SQLite (development):
DATABASE_URL=sqlite:///./cloud.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://cloud_user:cloud_pass@localhost:5432/cloud_db

# Application secret key — used for signing JWT tokens
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-production

# JWT settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Debug mode (set to false in production)
DEBUG=true

# Application version
APP_VERSION=0.1.0

# ─── Storage Settings ────────────────────────
# Root directory for user file storage (relative to backend/)
STORAGE_DIR=storage

# Maximum file size per upload (in MB)
MAX_FILE_SIZE_MB=50

# Default storage quota per user (in MB) — 1024 = 1 GB
DEFAULT_QUOTA_MB=1024
