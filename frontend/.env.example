# ===========================================
# Personalized Cloud Computing — Frontend Environment
# ===========================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
#
# Vite requires env vars to be prefixed with VITE_ to be
# exposed to the client-side code (security measure).

# ─── API Configuration ───────────────────────
# Override the backend API URL.
# If not set, the frontend automatically uses the same hostname
# as the current page with port 8000.
#
# Examples:
#   VITE_API_URL=http://localhost:8000       (default behavior)
#   VITE_API_URL=http://192.168.1.42:8000    (explicit LAN IP)
#   VITE_API_URL=https://cloud.example.com   (production domain)
#
# In most cases, you DON'T need to set this.
# The dynamic URL resolution handles localhost and LAN automatically.
# VITE_API_URL=
